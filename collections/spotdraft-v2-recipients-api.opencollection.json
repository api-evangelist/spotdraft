{
  "opencollection": "1.0.0",
  "info": {
    "name": "SpotDraft V1 Contract APIs V2 Recipients API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "V2 Recipients",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Recipient Link",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.eu.spotdraft.com/api/v2/public/contracts/:contract_id/recipients/recipient_link/",
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path",
                "description": "ID of the Contract."
              },
              {
                "name": "recipient_email",
                "value": "",
                "type": "query",
                "description": "Email of the recipient for whom the link needs to be generated."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "client-id",
              "value": "{{client-id}}",
              "placement": "header"
            }
          },
          "docs": "Get Recipient Link"
        }
      ]
    }
  ],
  "bundled": true
}