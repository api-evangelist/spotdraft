{
  "opencollection": "1.0.0",
  "info": {
    "name": "SpotDraft V1 Contract APIs V2.1 Contract Versions API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "V2.1 Contract Versions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload Contract Version.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.eu.spotdraft.com/api/v2.1/public/contracts/:contract_id/contract_version/",
            "params": [
              {
                "name": "contract_id",
                "value": "",
                "type": "path",
                "description": "ID of the Contract."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "client-id",
              "value": "{{client-id}}",
              "placement": "header"
            }
          },
          "docs": "Uploads a new contract version for an existing contract. Use this when you want to replace the working draft or add an executed version file to the contract history."
        }
      ]
    }
  ],
  "bundled": true
}